{
  "name": "pds-diary",
  "version": "1.0.0",
  "private": true,
  "description": "Plan-Do-See diary (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:wrangler": "wrangler dev",
    "db:remote": "wrangler d1 execute pds-diary --remote --file=./schema.sql",
    "test": "node scripts/api-test.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.136.1"
  },
  "type": "module"
}
